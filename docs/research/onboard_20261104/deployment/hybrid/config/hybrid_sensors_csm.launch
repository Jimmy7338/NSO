<launch>
  <!--Hybrid profile: existing camera launch owns static robot TF; RF2O alone owns odom->base_link; gmapping alone owns map->odom. No actuator.--><param name="use_sim_time" value="false" />
  <arg name="lidar_model" default="N301" />
  <arg name="device_ip" default="192.168.1.222" />
  <arg name="msop_port" default="2368" />
  <arg name="difop_port" default="2369" />
  <arg name="use_time_service" default="false" />
  <arg name="use_first_point_time" default="false" />
  <arg name="packet_rate" default="188.0" />
  <arg name="serial_port" default="" />
  <node pkg="lslidar_driver" type="lslidar_driver_node" name="lslidar_driver_node" output="screen" required="true">
    <param name="packet_rate" value="$(arg packet_rate)" />
    <param name="lidar_type" value="X10" />
    <param name="lidar_model" value="$(arg lidar_model)" />
    <param name="device_ip" value="$(arg device_ip)" />
    <param name="msop_port" value="$(arg msop_port)" />
    <param name="difop_port" value="$(arg difop_port)" />
    <param name="serial_port" value="$(arg serial_port)" />
    <param name="use_time_service" value="$(arg use_time_service)" />
    <param name="frame_id" value="laser_link" />
    <param name="pointcloud_topic" value="lslidar_point_cloud" />
    <param name="use_first_point_time" value="$(arg use_first_point_time)" />
    <param name="min_range" value="0.15" />
    <param name="max_range" value="25.0" />
    <param name="angle_disable_min" value="0" />
    <param name="angle_disable_max" value="0" />
    <param name="publish_scan" value="true" />
    <param name="use_high_precision" value="false" />
    <param name="publish_multiecholaserscan" value="false" />
    <param name="laserscan_topic" value="scan" />
    <param name="N10Plus_hz" value="10" />
    <param name="enable_noise_filter" value="false" />
    <param name="is_pretreatment" value="false" />
    <param name="x_offset" value="0.0" />
    <param name="y_offset" value="0.0" />
    <param name="z_offset" value="0.0" />
    <param name="roll" value="0.0" />
    <param name="pitch" value="0.0" />
    <param name="yaw" value="0.0" />
  </node>
  <include file="$(dirname)/csm_primary.launch" />
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen" required="true">
    <remap from="scan" to="scan" />
    <param name="base_frame" value="base_link" />
    <param name="odom_frame" value="odom" />
    <param name="map_frame" value="map" />
    <param name="tf_delay" value="0.1" />
    <param name="map_update_interval" value="2.0" />
    <param name="maxUrange" value="8.0" />
    <param name="lskip" value="0" />
    <param name="sigma" value="0.05" />
    <param name="kernelSize" value="1" />
    <param name="lstep" value="0.05" />
    <param name="astep" value="0.05" />
    <param name="iterations" value="5" />
    <param name="lsigma" value="0.075" />
    <param name="ogain" value="3.0" />
    <param name="srr" value="0.08" />
    <param name="srt" value="0.15" />
    <param name="str" value="0.08" />
    <param name="stt" value="0.15" />
    <param name="linearUpdate" value="0.2" />
    <param name="angularUpdate" value="0.15" />
    <param name="temporalUpdate" value="0.2" />
    <param name="resampleThreshold" value="0.5" />
    <param name="particles" value="80" />
    <param name="xmin" value="-10.0" />
    <param name="ymin" value="-10.0" />
    <param name="xmax" value="10.0" />
    <param name="ymax" value="10.0" />
    <param name="delta" value="0.05" />
    <param name="llsamplerange" value="0.01" />
    <param name="llsamplestep" value="0.01" />
    <param name="lasamplerange" value="0.008" />
    <param name="lasamplestep" value="0.008" />
  <remap from="map" to="/nso_visual/map" /><remap from="map_metadata" to="/nso_visual/map_metadata" /></node>
</launch>