<launch>
  <group ns="nso_csm">
    <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" name="matcher" output="screen" required="true">
      <remap from="scan" to="/scan" />
      <param name="base_frame" value="base_link" />
      <param name="fixed_frame" value="odom" />
      <param name="publish_tf" value="false" />
      <param name="publish_pose" value="false" />
      <param name="publish_pose_stamped" value="true" />
      <param name="publish_pose_with_covariance" value="false" />
      <param name="publish_pose_with_covariance_stamped" value="false" />
      <param name="use_imu" value="false" />
      <param name="use_odom" value="false" />
      <param name="use_vel" value="false" />
      <!-- This matcher supplies odom TF itself; do not wait for its own next pose. -->
      <param name="use_tf" value="false" />
    </node>
  </group>
</launch>
