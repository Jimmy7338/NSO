  "algorithm_python": "def upright_tls(points, orienting_camera):\n    center = points.mean(axis=0)\n    _, axes = np.linalg.eigh(np.cov(points[:, :2], rowvar=False, bias=True))\n    normal = np.r_[axes[:, 0], 0.]\n    if np.dot(normal, orienting_camera-center) < 0:\n        normal *= -1\n    horizontal = np.cross([0., 0., 1.], normal)\n    uv = np.c_[(points-center) @ horizontal, points[:, 2]-center[2]]\n    anchor = center + horizontal*(uv[:, 0].max()+uv[:, 0].min())*.5\n    anchor += np.array([0., 0., 1.])*(uv[:, 1].max()+uv[:, 1].min())*.5\n    return dict(normal=normal.tolist(), yaw_deg=float(np.rad2deg(np.arctan2(normal[1],normal[0]))),\n        anchor_estimate_m=anchor.tolist(), observed_extent_m=np.ptp(uv, axis=0).tolist(),\n        rms_m=float(np.sqrt(np.mean(((points-center) @ normal)**2))))\n",
