# Prepared, NOT built in this probe. Context: pinned tare_official directory.
# linux/amd64 official ROS Noetic ros-core manifest inspected without pulling.
FROM ros@sha256:4c1435fd85be3edde3820f0d132ab30a6b030209dce4fa3ac428a2aa5a763caf
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake \
    ros-noetic-nav-msgs ros-noetic-roscpp ros-noetic-rospy \
    ros-noetic-sensor-msgs ros-noetic-std-msgs ros-noetic-pcl-ros \
    libeigen3-dev libgoogle-glog-dev \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
COPY src /opt/tare_ws/src
RUN source /opt/ros/noetic/setup.bash \
    && cd /opt/tare_ws/src && catkin_init_workspace \
    && cd /opt/tare_ws && catkin_make -j1 -l1
WORKDIR /opt/tare_ws
CMD ["bash", "-lc", "source devel/setup.bash && roslaunch tare_planner explore_garage.launch rviz:=false rosbag_record:=false"]
